# Copy to .env and adjust.
DATABASE_URL=postgres://rawtisserie:rawtisserie@localhost:5433/rawtisserie
# Where original RAW files, rendered previews and LUTs are stored (relative to the repo
# root), and uploads in progress. With S3_BUCKET set, only uploads in progress.
STORAGE_DIR=data
# S3-compatible object storage for originals, renders and LUTs, instead of STORAGE_DIR.
# OVHcloud: S3_ENDPOINT=https://s3.<region>.io.cloud.ovh.net, S3_REGION=<region>.
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true for servers that need the bucket in the path (e.g. MinIO, rclone serve s3).
# S3_PATH_STYLE=false
PORT=4000
# true to let anyone create an account; otherwise sign-up needs an invitation (made by an
# admin at /admin; make the first admin with `npm run user:admin -w @rawtisserie/server
# -- you@example.com`).
ALLOW_SIGNUP=true
# Storage quota, in GB (1024³ bytes), of accounts created without an invitation. Unset:
# unlimited.
# DEFAULT_STORAGE_QUOTA_GB=
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# true behind a reverse proxy that sets X-Forwarded-For (and that clients can't go around):
# rate limits then count signed-out requests by the client's address, not the proxy's.
# TRUST_PROXY=true
# true to let users connect instances at private addresses (http://localhost:4001…), to
# try sending photos between local instances. Leave unset on a public server.
# ALLOW_PRIVATE_INSTANCES=true
# Number of RAW files rendered concurrently (each takes a worker thread).
RENDER_CONCURRENCY=2
