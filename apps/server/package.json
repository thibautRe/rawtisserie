{
  "name": "@rawtisserie/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch-path=src --watch-path=../../packages/pipeline/src --watch-path=../../packages/pipeline/wasm src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "user:admin": "node --env-file-if-exists=../../.env src/scripts/user-admin.ts",
    "user:invite": "node --env-file-if-exists=../../.env src/scripts/invite.ts",
    "db:schema": "node --env-file-if-exists=../../.env ../../node_modules/@databases/pg-schema-cli/lib/cli.js && node src/scripts/fix-generated-types.ts",
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@databases/pg": "^6.1.0",
    "@databases/pg-migrations": "^6.0.0",
    "@databases/pg-typed": "^5.0.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@rawtisserie/pipeline": "*",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@databases/pg-schema-cli": "^5.0.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "pg": {
    "connectionStringEnvironmentVariable": "DATABASE_URL",
    "migrationsDirectory": "migrations",
    "types": {
      "directory": "src/__generated__",
      "primaryKeyTypeMode": "inline_no_brand",
      "domainTypeMode": "inline",
      "columnTypeOverrides": {
        "photos.exif": "import('@rawtisserie/pipeline').PhotoMetadata",
        "versions.flag": "'picked' | 'rejected'",
        "versions.color_label": "'red' | 'yellow' | 'green' | 'blue' | 'purple'",
        "versions.render_status": "'pending' | 'ready' | 'failed'",
        "versions.render_format": "'jpeg' | 'avif'",
        "history_entries.recipe": "import('@rawtisserie/pipeline').EditParams",
        "presets.kind": "'module' | 'style'",
        "presets.module_kind": "import('@rawtisserie/pipeline').ModuleKind",
        "presets.payload": "import('@rawtisserie/pipeline').ModulePresetPayload | import('@rawtisserie/pipeline').StylePayload"
      }
    }
  }
}
