# Copy to deploy/.env on the server and fill it in. Never commit the copy.

# The public host name; its DNS must point at this machine for HTTPS certificates.
DOMAIN=rawtisserie.example.com

# Letters and digits only (it goes into a connection URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The server image. Pin a tag to deploy a given build.
RAWTISSERIE_IMAGE=ghcr.io/thibautre/rawtisserie:latest

# true to let new accounts be created.
ALLOW_SIGNUP=false
# RAW files rendered at once in the background (each takes a CPU core).
RENDER_CONCURRENCY=2

# Database dumps: a directory on this machine, the hour (UTC) to start from, and how
# many days to keep them (here and in the bucket).
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30

# A copy of the dumps in an S3 bucket, off this machine (empty bucket: no copy). The
# bucket must exist. For OVHcloud: the endpoint is https://s3.<region>.io.cloud.ovh.net
# (e.g. region gra), and the keys are an S3 user's, allowed to read, write and delete
# in that bucket only. BACKUP_S3_PROVIDER is rclone's name for the provider.
BACKUP_S3_BUCKET=
BACKUP_S3_PROVIDER=OVHcloud
BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
BACKUP_S3_REGION=gra
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
