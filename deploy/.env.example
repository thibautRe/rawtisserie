# Copy to deploy/.env on the server and fill it in. Never commit the copy.

# The public host name; its DNS must point at this machine for HTTPS certificates.
DOMAIN=rawtisserie.example.com

# Letters and digits only (it goes into a connection URL), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The server image. Pin a tag to deploy a given build.
RAWTISSERIE_IMAGE=ghcr.io/thibautre/rawtisserie:latest

# true to let new accounts be created.
ALLOW_SIGNUP=false
# RAW files rendered at once in the background (each takes a CPU core).
RENDER_CONCURRENCY=2

# Database dumps: a directory on this machine, the hour (UTC) to start from, and how
# long to keep them. Copy them off the machine too: a dump next to the database doesn't
# survive losing the machine.
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=30
